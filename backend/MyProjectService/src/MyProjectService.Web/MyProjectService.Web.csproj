<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenApiEnableXmlCommentsSupport>false</OpenApiEnableXmlCommentsSupport>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\MyProjectService.Contracts\MyProjectService.Contracts.csproj" />
    <ProjectReference Include="..\MyProjectService.Core\MyProjectService.Core.csproj" />
    <ProjectReference Include="..\MyProjectService.Domain\MyProjectService.Domain.csproj" />
    <ProjectReference Include="..\MyProjectService.Infrastructure.Postgres\MyProjectService.Infrastructure.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <!-- ДОБАВЬ ЭТОТ БЛОК В САМЫЙ КОНЕЦ ФАЙЛА -->
  <Target Name="RemoveOpenApiGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>

</Project>





